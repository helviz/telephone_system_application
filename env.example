# ─────────────────────────────────────────────
# Telnyx Configuration
# ─────────────────────────────────────────────
TELNYX_API_KEY=your_telnyx_api_key_here
TELNYX_PUBLIC_KEY=your_telnyx_public_key_here
TELNYX_APP_ID=your_telnyx_app_id_here

# Public URL where Telnyx webhooks will hit (use ngrok for local dev)
BASE_URL=https://your-public-url.com

# ─────────────────────────────────────────────
# Google Gemini (replaces local Ollama/Qwen3)
# Get your key: https://aistudio.google.com/app/apikey
# ─────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# Model options (fastest → smartest):
#   gemini-2.0-flash        ← recommended (best speed/quality tradeoff)
#   gemini-2.0-flash-lite   ← cheapest, ~150ms latency
#   gemini-1.5-flash        ← fallback
GEMINI_MODEL=gemini-2.0-flash

MAX_TOKENS=150
TEMPERATURE=0.7

# ─────────────────────────────────────────────
# STT / TTS Models
# ─────────────────────────────────────────────
# Whisper model size: tiny.en (fastest) → base.en → small.en → medium.en
WHISPER_MODEL=base.en

# Piper voice model
PIPER_MODEL=en_US-lessac-medium

# ─────────────────────────────────────────────
# Infra (leave defaults for docker-compose)
# ─────────────────────────────────────────────

POSTGRES_DB=postgresql://postgres:OF5deqGRJ12hP9oR@db.lxotynlqmeelrstydmru.supabase.co:5432/postgres
