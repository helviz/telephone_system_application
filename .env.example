# ── Server ────────────────────────────────────────────────────────────────────
# Your public hostname (no scheme, no trailing slash).
# When using ngrok: run `ngrok http 5000` and paste the hostname here.
# e.g. abc123.ngrok-free.app
PUBLIC_HOST=

# Port the uvicorn server listens on (default 5000)
PORT=

# ── LLM ───────────────────────────────────────────────────────────────────────
# "gemini" uses Google Gemini API (requires GEMINI_API_KEY below)
# "qwen"   uses local GGUF model (no API key needed, needs the model file)
LLM_PROVIDER=

# Language for STT + LLM + TTS: "en", "fr", or "sw"
VOICE_LANG=en

# ── API Keys ───────────────────────────────────────────────────────────────────
GEMINI_API_KEY=

# Hugging Face token (only needed if downloading gated models)
HF_TOKEN=

# ── Twilio ─────────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Set to "false" to skip Twilio signature validation during local dev
VALIDATE_TWILIO_SIGNATURE=true

# ── Telnyx ─────────────────────────────────────────────────────────────────────
# No special env vars needed for Telnyx TeXML streaming — just point your
# Telnyx TeXML application webhook to: https://<PUBLIC_HOST>/telnyx/voice

